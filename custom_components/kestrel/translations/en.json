{
  "config": {
    "flow_title": "{name}",
    "step": {
      "bluetooth_confirm": {
        "description": "Do you want to set up {name}?"
      },
      "user": {
        "description": "Choose a Kestrel device to set up.",
        "data": {
          "address": "Device"
        },
        "data_description": {
          "address": "Kestrel devices discovered via Bluetooth."
        }
      }
    },
    "abort": {
      "already_configured": "Device is already configured",
      "already_in_progress": "Configuration flow is already in progress",
