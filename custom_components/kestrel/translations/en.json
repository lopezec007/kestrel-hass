  "services": {
    "import_data_log": {
      "name": "Import data log",
      "description": "Downloads the on-device data log over the Kestrel LiNK protocol and imports it as hourly long-term statistics for the device's sensors.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The Kestrel device to download from."
        },
        "mode": {
          "name": "Mode",
          "description": "Import only records newer than the last import, or the whole log."
        }
      }
    }
  },
  "selector": {
    "import_mode": {
      "options": {
        "new": "New records only",
        "all": "Entire log"
      }
    }
  },
  "exceptions": {
    "recorder_not_loaded": {
      "message": "The recorder integration must be loaded to import statistics."
    },
    "device_not_found": {
      "message": "Device {device_id} was not found."
    },
    "not_kestrel_device": {
      "message": "Device {device_id} is not a Kestrel device."
    },
    "entry_not_loaded": {
      "message": "The Kestrel device {device_id} is not loaded."
    },
    "download_failed": {
      "message": "Downloading the data log failed: {error}"
    }
  }
